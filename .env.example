APP_NAME="Optik CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Production Log Settings (Rotasi harian agar disk tidak penuh)
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database MySQL Production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=optikcrm_db
DB_USERNAME=optikcrm_user
DB_PASSWORD=your_strong_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# WhatsApp Gateway (Fonnte)
# Ganti FONNTE_MODE ke 'live' HANYA saat siap kirim pesan sungguhan ke WhatsApp pelanggan
FONNTE_MODE=dry_run
FONNTE_API_TOKEN=your_fonnte_device_token_here
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_PACING_SECONDS=2
# Rahasia untuk webhook status Fonnte (kosong = webhook nonaktif). Buat acak panjang, mis. `php -r "echo bin2hex(random_bytes(24));"`.
# URL webhook yang didaftarkan di dashboard Fonnte: https://api.crmoptik.com/api/webhooks/fonnte/status?secret=<nilai ini>
FONNTE_WEBHOOK_SECRET=

# BPJS Provider Invoice Pattern (Regex format klaim BPJS Optik Cengkareng)
BPJS_INVOICE_PATTERN=0115[O0-9]006L

# Reverse Proxy Trust
# Biarkan KOSONG jika direct connection / shared hosting tanpa reverse proxy (mencegah bypass throttle lewat spoofing X-Forwarded-For).
# Jika menggunakan Cloudflare/Reverse proxy terpercaya, isi daftar IP/subnet proxy (dipisahkan koma).
TRUSTED_PROXIES=

